# Copiar para .env e ajustar. Todos os valores aqui são fictícios.

# Porta do backend (o frontend em desenvolvimento encaminha /api para esta porta)
PORTA=3000

# Caminho do ficheiro SQLite, relativo à raiz do repositório
CAMINHO_BD=dados/matriz.sqlite

# Horas sem atividade até a sessão expirar (P2)
SESSAO_HORAS=8

# Palavra-passe das contas de demonstração criadas pelo seed (P10).
# Valor fictício; usar apenas em desenvolvimento.
SEED_PALAVRA_PASSE=demo-matriz-2026

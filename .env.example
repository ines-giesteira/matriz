# Copiar para .env e ajustar. Todos os valores aqui são fictícios.

# Ambiente: "development" só no computador de quem desenvolve. Sem este valor, a Matriz comporta-se como em
# produção: o seed de demonstração recusa correr (RV-37).
NODE_ENV=development

# Porta do backend (o frontend em desenvolvimento encaminha /api para esta porta)
PORTA=3000

# Caminho do ficheiro SQLite, relativo à raiz do repositório
CAMINHO_BD=dados/matriz.sqlite

# Horas sem atividade até a sessão expirar (P2)
SESSAO_HORAS=8

# Docker Compose: porta deste computador onde fica a interface (http://localhost:8080). Só o compose a usa (P45).
PORTA_DOCKER=8080

# Palavra-passe das contas de demonstração criadas pelo seed (P10), com pelo menos 8 caracteres.
# Este valor é público: mude-o no .env, porque o seed recusa correr com ele (RV-37).
SEED_PALAVRA_PASSE=demo-matriz-2026
